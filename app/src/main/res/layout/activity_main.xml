<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reachability Helper"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="To use this app, please enable the following permissions:"
        android:layout_marginBottom="16dp"
        android:textAlignment="center"/>

    <Button
        android:id="@+id/btn_accessibility_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Accessibility Service"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btn_overlay_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Display Over Other Apps"/>

</LinearLayout>
